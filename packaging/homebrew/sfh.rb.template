class Sfh < Formula
  desc "Chain AI CLI agents and commands into YAML-defined flows"
  homepage "https://github.com/Aero123421/SimpleFlowHarness"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    if Hardware::CPU.arm?
      url "https://github.com/Aero123421/SimpleFlowHarness/releases/download/v{{VERSION}}/sfh-macos-arm64.tar.gz"
      sha256 "{{MACOS_ARM64_SHA256}}"
    else
      url "https://github.com/Aero123421/SimpleFlowHarness/releases/download/v{{VERSION}}/sfh-macos-x64.tar.gz"
      sha256 "{{MACOS_X64_SHA256}}"
    end
  end

  on_linux do
    if Hardware::CPU.arm?
      url "https://github.com/Aero123421/SimpleFlowHarness/releases/download/v{{VERSION}}/sfh-linux-arm64.tar.gz"
      sha256 "{{LINUX_ARM64_SHA256}}"
    else
      url "https://github.com/Aero123421/SimpleFlowHarness/releases/download/v{{VERSION}}/sfh-linux-x64.tar.gz"
      sha256 "{{LINUX_X64_SHA256}}"
    end
  end

  def install
    bin.install "sfh"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/sfh --version")
  end
end
