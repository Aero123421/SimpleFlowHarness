# A CRLF shell script is a syntax error to /bin/sh, and CI runs tests/*.sh on
# Linux and macOS. Pin them to LF so a Windows checkout with core.autocrlf=true
# cannot produce a tree that only works on the machine it was cloned on.
*.sh text eol=lf

# Flow files travel between machines inside run dirs. sfh normalises line
# endings before fingerprinting (so a CRLF checkout and an LF one are the same
# flow), but keeping the checkout itself LF avoids pointless churn.
*.yaml text eol=lf
*.yml  text eol=lf

# Release resources are packaged on Linux, macOS, and Windows. Keep their
# bytes stable so archive manifests and attestations do not depend on runner
# checkout policy.
*.md   text eol=lf
*.json text eol=lf
*.py   text eol=lf
*.ps1  text eol=lf
*.txt  text eol=lf
LICENSE text eol=lf
Cargo.toml text eol=lf
Cargo.lock text eol=lf
*.rb text eol=lf

# This file is embedded verbatim in every platform archive and is compared by
# installers as the ownership and resource-layout contract.
release-resources.txt text eol=lf

# Rust sources: rustfmt writes LF, and a mixed tree makes every diff noisy.
*.rs   text eol=lf
.gitattributes text eol=lf
