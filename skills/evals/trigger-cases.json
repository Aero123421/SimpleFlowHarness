{
  "schema_version": 1,
  "instructions": "Run each case several times because skill activation is nondeterministic. should_trigger names the expected skill.",
  "cases": [
    {
      "prompt": "sfhで実装→テスト→レビュー→修正のYAMLを作って",
      "should_trigger": [
        "sfh-flow-design",
        "sfh-loop-engineering"
      ]
    },
    {
      "prompt": "このSimpleFlowHarnessのflow.yamlをレビューして、壊れやすいループを直して",
      "should_trigger": [
        "sfh-flow-review",
        "sfh-loop-engineering"
      ]
    },
    {
      "prompt": "cargo testの結果をAIに判定させずrouteしたい",
      "should_trigger": [
        "sfh-deterministic-gates"
      ]
    },
    {
      "prompt": "同じreview/fixを何度も回して収束しない",
      "should_trigger": [
        "sfh-loop-engineering"
      ]
    },
    {
      "prompt": "workspace:autoとcontextsをどう組み合わせる？",
      "should_trigger": [
        "sfh-context-workspace"
      ]
    },
    {
      "prompt": "外部API送信stepをクラッシュ後に二重実行したくない",
      "should_trigger": [
        "sfh-failure-recovery"
      ]
    },
    {
