        "sfh-ci-monitoring",
        "sfh-flow-design"
      ]
    },
    {
      "prompt": "web検索CLIのJSONを証拠として保存してからAIに要約させたい",
      "should_trigger": [
        "sfh-tool-integration"
      ]
    },
    {
      "prompt": "MCP経由でread-only調査するstepを安全に設計したい",
      "should_trigger": [
        "sfh-tool-integration",
        "sfh-failure-recovery"
      ]
    },
    {
      "prompt": "本番障害を再現テストにしてから直すloopを作りたい",
      "should_trigger": [
        "sfh-eval-engineering",
        "sfh-loop-engineering"
      ]
    },
    {
